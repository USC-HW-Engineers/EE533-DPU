VERSION 5
BEGIN SYMBOL Zero_Detect
SYMBOLTYPE BLOCK
TIMESTAMP 2026 10 20 3 25 8
SYMATTR VeriModel "Zero_Detect"
SYMPIN 0 -32 Input result(63:0)
SYMPIN 384 -32 Output Z
BEGIN DISPLAY 192 -72 ATTR SymbolName
    ALIGNMENT BCENTER
    FONT 56 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -32 PIN result(63:0) ATTR PinName
    FONT 24 "Arial"
END DISPLAY
RECTANGLE N 0 -44 64 -20 
LINE N 64 -32 0 -32 
RECTANGLE N 64 -64 320 0 
BEGIN DISPLAY 312 -32 PIN Z ATTR PinName
    ALIGNMENT RIGHT
    FONT 24 "Arial"
END DISPLAY
LINE N 320 -32 384 -32 
END SYMBOL
